{
	"manifest_version": 3,
	"name": "Reactive Resume Capture Queue",
	"version": "0.1.3",
	"description": "Save job postings to your own Reactive Resume installation without AI calls.",
	"minimum_chrome_version": "120",
	"permissions": ["storage", "activeTab", "scripting", "alarms"],
	"host_permissions": ["https://jobright.ai/*"],
	"optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
	"background": { "service_worker": "src/background.js", "type": "module" },
	"action": { "default_title": "Queue this job in Reactive Resume" },
	"options_ui": { "page": "options.html", "open_in_tab": true },
	"commands": {
		"capture-job": {
			"suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
			"description": "Queue the job on this page"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://jobright.ai/*"],
			"js": ["src/extractor.js", "src/liked.js"],
			"run_at": "document_idle"
		}
	]
}
